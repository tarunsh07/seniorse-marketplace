<% layout("/layouts/boilerplate") %>

    <div class="hero-container mt-4 mb-4">
        <video class="hero-video" autoplay muted playsinline>
            <source src="/assets/video.mp4" type="video/mp4">
        </video>
    </div>

    <div class="container mb-5 text-center">
        <h1 class="d-flex justify-content-center align-items-center mb-5"
            style="color: #333; gap: 15px; font-size: 3.5rem; font-weight: 900;">
            What is <img src="/assets/logo_large.webp" alt="logo" style="height: 4rem; object-fit: contain;"> ?
        </h1>
        <div class="row g-4 text-start">
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="fa-solid fa-cart-shopping fa-2x feature-icon"></i>
                    <h4 class="fw-bold">Buy. Sell. Pass It On.</h4>
                    <p class="text-muted mb-0">Everything a student needs from calculators and lab coats to books,
                        notes, and gadgets all inside your campus network.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="fa-solid fa-building-columns fa-2x feature-icon"></i>
                    <h4 class="fw-bold">Built for Campus Life</h4>
                    <p class="text-muted mb-0">Find affordable essentials from seniors, connect with trusted students,
                        and give unused items a second life instead of letting them collect dust.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="fa-solid fa-shield-halved fa-2x feature-icon"></i>
                    <h4 class="fw-bold">Student Marketplace, Simplified</h4>
                    <p class="text-muted mb-0">No random strangers. No complicated listings. Just a clean, trusted space
                        where students help students.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="fa-solid fa-users fa-2x feature-icon"></i>
                    <h4 class="fw-bold">From Seniors To Juniors</h4>
                    <p class="text-muted mb-0">Grab pre loved essentials at better prices while building a stronger
                        campus community.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="fa-solid fa-leaf fa-2x feature-icon"></i>
                    <h4 class="fw-bold">Smarter Than Buying New</h4>
                    <p class="text-muted mb-0">Save money, reduce waste, and discover useful stuff already around you on
                        campus.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="fa-solid fa-box-open fa-2x feature-icon"></i>
                    <h4 class="fw-bold">Everything Students Actually Need</h4>
                    <p class="text-muted mb-0">Books. Electronics. Cycles. Calculators. Notes. Lab coats. And the random
                        hostel stuff everyone ends up searching for</p>
                </div>
            </div>
        </div>

        <div class="mt-5 pt-4">
            <a href="/listings" class="btn-lets-see">Letssss Seeeee...</a>
        </div>
    </div>