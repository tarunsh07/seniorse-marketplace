<% layout("/layouts/boilerplate") %>

<script>
    document.body.classList.add('auth-page-bg');
</script>

<div class="row mt-3">
    <div class="col-6 offset-3">
        <div class="text-center mt-2 mb-4">
            <h3 class="fw-bold" style="color: #333; letter-spacing: 1px;">Verify Your College ID</h3>
            <hr class="mx-auto mt-2" style="width: 60px; border: 2px solid #FE6602; opacity: 1; border-radius: 5px;">
        </div>
        
        <form action="/verify-otp" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="enteredOtp" class="form-label">Enter the 6-digit OTP sent to your college email</label>
                <input 
                    name="enteredOtp" 
                    id="enteredOtp" 
                    placeholder="e.g. 123456" 
                    type="text" 
                    class="form-control" 
                    required>
                <div class="invalid-feedback">Please enter the valid 6-digit OTP.</div>
            </div>
            <button class="btn btn-dark add-btn mt-3 w-100">Verify & Register</button>
        </form>
    </div>
</div>
