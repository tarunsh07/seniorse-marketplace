<% layout("/layouts/boilerplate") %>

<script>
    document.body.classList.add('auth-page-bg');
</script>

<div class="row mt-3">
    <div class="col-6 offset-3">
        <div class="text-center mt-2 mb-4">
            <h3 class="fw-bold" style="color: #333; letter-spacing: 1px;">Welcome Back</h3>
            <hr class="mx-auto mt-2" style="width: 60px; border: 2px solid #FE6602; opacity: 1; border-radius: 5px;">
        </div>
        <form action="/login" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input 
                    name="username" 
                    id="username"
                    type="text" 
                    class="form-control" 
                    required> 
                <div class="invalid-feedback">Please enter a username</div>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input 
                    name="password" 
                    id="password"
                    type="password" 
                    class="form-control" 
                    required> 
                <div class="invalid-feedback">Please enter a password</div>
            </div>
            <button class="btn btn-dark add-btn mt-3">LogIn</button>
        </form>
    </div>
</div>